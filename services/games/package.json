{
  "name": "@crash/games",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:e2e": "docker compose -f docker-compose.test.yml up -d --wait && bun --env-file=.env.test run migration:up && bun --env-file=.env.test test tests/e2e; docker compose -f docker-compose.test.yml down",
    "migration:generate": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:status": "mikro-orm migration:list"
  },
  "dependencies": {
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.17",
    "@nestjs/microservices": "^11",
    "@nestjs/schedule": "^5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11",
    "amqp-connection-manager": "^4",
    "amqplib": "^0.10",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "pg": "^8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6",
    "@nestjs/testing": "^11.1.24",
    "@swc/core": "^1.15.40",
    "@types/amqplib": "^0.10",
    "bun-types": "latest",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
